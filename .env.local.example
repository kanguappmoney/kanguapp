# Copie para .env.local e preencha. NÃO commitar .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (client-safe). LEVA NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (acesso total, ignora RLS). NUNCA leva NEXT_PUBLIC_. Só servidor.
SUPABASE_SECRET_KEY=

# Mapbox — só o modo Mapa (fase depois da Linha do tempo). Token público.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Asaas — só depois do piloto (webhook). Deixar vazio por ora.
ASAAS_API_KEY=
